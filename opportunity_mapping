SELECT

    OP.ID AS OPPORTUNITY_ID,
    OLI.ID AS OPPORTUNITY_LINE_ID,
    P2.PRODUCTCODE AS PRODUCT_CODE,
    PQL.ID AS PARENT_QUOTE_LINE_ID,
    //CQL.ID AS CHILD_QUOTE_LINE_ID,
    SUB.ID AS SUBSCRIPTION_ID,
    //CSUB.ID AS CHILD_SUBSCRIPTION_ID,
    P2.ID AS PRODUCT2_ID,
    P2.PRODUCT_FAMILY_CUSTOM__C AS PRODUCT_FAMILY_CUSTOM,
    OLI.TCV__C / IFNULL(DCT.CONVERSIONRATE, 1) AS OPP_LINE_TCV_CURRENCY,
    OPP_LINE_TCV_CURRENCY / (DATEDIFF('DAY',SUB.SBQQ__STARTDATE__C,SUB.SBQQ__ENDDATE__C)) * 365 AS CALCULATED_ATR,
    SUB.EACV_CALCULATED_SUB__C AS SUBSCRIPTION_EACV,
    SUB.SBQQ__STARTDATE__C AS SUBSCRIPTION_START_DATE,
    SUB.SBQQ__ENDDATE__C AS SUBSCRIPTION_END_DATE,
    RENEWAL_OP.ID AS RENEWAL_OPPORTUNITY_ID,
    RENEWAL_OP.CLOSEDATE    AS RENEWAL_OP_CLOSE_DATE,
    RENEWAL_OP.STAGENAME AS RENEWAL_STAGE_NAME,
    ec.sbqq__opportunity__c as expiring_opportunity,
    cop.id as consolidated_into_renewal_op



FROM DATALAKE_DB.SALESFORCE.OPPORTUNITY OP

JOIN DATALAKE_DB.SALESFORCE.OPPORTUNITYLINEITEM OLI
    ON OLI.OPPORTUNITYID = OP.ID

JOIN DATALAKE_DB.SALESFORCE.SBQQ__QUOTELINE__C PQL -- THE PARENT QUOTELINE. THE ONE THAT GENERATES THE BUNDLE
    ON PQL.ID = OLI.SBQQ__QUOTELINE__C

-- JOIN DATALAKE_DB.SALESFORCE.SBQQ__QUOTELINE__C CQL  -- CHILD QUOTELINES. THE ITEMS IN THE BUNDLE. NO LONGER RELEVANT, BUT INCLUDING FOR CONTEXT
--     ON CQL.SBQQ__REQUIREDBY__C = PQL.ID

left JOIN DATALAKE_DB.SALESFORCE.SBQQ__SUBSCRIPTION__C SUB
    ON SUB.SBQQ__QUOTELINE__C = PQL.ID
    AND SUB.ITEM_TYPE__c = 'Selling Item' -- excludes 'virtual bundles' .. dont worry about this, just include the filter

-- JOIN DATALAKE_DB.SALESFORCE.SBQQ__SUBSCRIPTION__C CSUB --CHILD SUBSCRIPTION, EACH SUBSCRIPTION FOR EACH CHILD ITEM. WILL NOT BE MIGRATED
--     ON CSUB.SBQQ__QUOTELINE__C = CQL.ID

JOIN DATALAKE_DB.SALESFORCE.PRODUCT2 P2
    ON P2.ID = OLI.PRODUCT2ID

LEFT JOIN DATALAKE_DB.SALESFORCE.DATEDCONVERSIONRATE DCT -- CONVERSION RATE TO CHANGE FROM EUR & GBP INTO USD
    ON DCT.ISOCODE = OP.CURRENCYISOCODE
    AND OP.CLOSEDATE BETWEEN DCT.STARTDATE AND DCT.NEXTSTARTDATE

LEFT JOIN DATALAKE_DB.SALESFORCE.CONTRACT CT -- EVERY SUBSCRIPTION HAS A CONTRACT - THE CONTRACT TELLS US IF THERE IS AN OPEN RENEWAL OPPORTUNITY OR NOT.
    ON SUB.SBQQ__CONTRACT__C = CT.ID

LEFT JOIN DATALAKE_DB.SALESFORCE.OPPORTUNITY RENEWAL_OP
    ON RENEWAL_OP.ID = CT.SBQQ__RENEWALOPPORTUNITY__C

left join datalake_db.salesforce.opportunity cop -- consolidated opp
    on cop.id = renewal_op.consolidated_into__c


left join datalake_db.salesforce.contract ec --expiring contract
    on ec.sbqq__renewalopportunity__c = op.id

WHERE OP.ID = '006Ht00000yVQMiIAO'
