create or replace table analytics_sandbox.main.atr_sub_base_t as

with

subscription as (
	select * from staging.salesforce.stg_salesforce__sbqq__subscription
),

quote_line as (
	select * from staging.salesforce.stg_salesforce__sbqq__quoteline
),

quote as (
	select * from staging.salesforce.stg_salesforce__sbqq__quote
),

opportunity as (
	select * from staging.salesforce.stg_salesforce__opportunity
),

opportunity_line as (
	select * from staging.salesforce.stg_salesforce__opportunity_line_item
),

contract as (
	select * from staging.salesforce.stg_salesforce__contract
),

product as (
	select * from staging.salesforce.stg_salesforce__product2
),

account as (
	select * from staging.salesforce.stg_salesforce__account
),

replacement as (
	select * from staging.salesforce.stg_salesforce__replacement
),


family_map as (
	select column1 as family, column2 as family_group
	from values
		('PAM Self-Hosted', 'PAM'), ('PAM SaaS', 'PAM'), ('SIM', 'PAM'), ('Hardware', 'PAM'), ('Cloud Security', 'PAM'),
		('Workforce & Customer Access', 'Identity Access'), ('Remote Access', 'Identity Access'), ('Identity Management', 'Identity Access'),
		('Secrets Manager', 'Secrets & AI'), ('AI', 'Secrets & AI'),
		('EPM', 'EPM'),
		('MIM', 'MIM'),
		('Maintenance', 'Maintenance'),
		('PS', 'PS')
),

opp_lines as (
	select
		oli.sbqq__quoteline__c as quote_line_id,
		any_value(oli.opportunity_line_id) as opp_line_id,
		sum(oli.acv__c) as oli_acv,
		sum(oli.totalprice) as oli_total,
		sum(oli.quantity) as oli_quantity,
		min(to_date(oli.line_start_date__c)) as oli_start_date,
		max(to_date(oli.line_end_date__c)) as oli_end_date
	from opportunity_line oli
	join quote_line ql on ql.id = oli.sbqq__quoteline__c
	join quote q on q.id = ql.sbqq__quote__c and q.sbqq__opportunity2__c = oli.opp_id
	group by 1
),

replaced_qty as (
	select
		r.original_subscription_c as subscription_id,
		sum(r.replaced_quantity_c) as replaced_quantity,
		max(r.current_quantity_c) as repl_current_quantity
	from replacement r
	join quote q on q.id = r.replacement_quote_c and not ifnull(q.isdeleted, false)
	join opportunity o on o.id = q.sbqq__opportunity2__c and o.stagename = 'Closed Won'
	where not ifnull(r.isdeleted, false)
		and r.status_c = 'Replaced'
	group by 1
),

subs as (
	select
		s.id as subscription_id,
		s.sbqq__account__c as account_id,
		a.name as account_name,
		coalesce(oo.named_end_tenant__c, c.named_end_tenant__c, s.sbqq__account__c) as tenant_id,
		s.sbqq__contract__c as contract_id,
		s.currencyisocode as currency,
		to_date(s.sbqq__startdate__c) as sub_start_date,
		to_date(s.sbqq__enddate__c) as sub_end_date,
		to_date(s.sbqq__terminateddate__c) as terminated_date,
		least(ifnull(terminated_date, sub_end_date), sub_end_date) as effective_end_date,
		s.replacement_status__c as replacement_status,
		s.item_type__c as item_type,
		s.sbqq__product__c as product_id,
		p.productcode as product_code,
		p.name as product_name,
		p.product_family_custom__c,
		f.family_group,
		s.sbqq__quoteline__c as quote_line_id,
		ql.sbqq__renewedsubscription__c as renewed_subscription_id,
		ql.sbqq__upgradedsubscription__c as upgraded_subscription_id,
		ifnull(ql.isdeleted, false) or ifnull(oq.isdeleted, false) as is_deleted_line,
		ql.sbqq__quote__c as origin_quote_id,
		oq.sbqq__opportunity2__c as origin_opportunity_id,
		oo.name as origin_opportunity_name,
		oo.stagename as origin_opp_stage,
		to_date(oo.closedate) as origin_close_date,
		oli.opp_line_id,
		oli.oli_quantity,
		oli.oli_total,
		oli.oli_acv,
		s.sbqq__customerprice__c as customer_price,
		s.sbqq__quantity__c as quantity,
		s.original_quantity__c as original_quantity,
		rq.replaced_quantity,
		case
			when s.replacement_status__c in ('Replaced', 'Partial Replacement') and s.original_quantity__c > 0 then s.original_quantity__c
			when s.sbqq__quantity__c = 0 then ifnull(rq.repl_current_quantity, 0)
			else s.sbqq__quantity__c
		end as atr_quantity,
		ifnull(s.sbqq__regularprice__c, 0) = 0 as is_zero_priced,
		oli.oli_start_date is not null and oli.oli_end_date is not null as has_oli_dates,
		coalesce(
			case when has_oli_dates then oli.oli_start_date end,
			to_date(ql.sbqq__effectivestartdate__c),
			sub_start_date
		) as term_start_date,
		coalesce(
			case when has_oli_dates then oli.oli_end_date end,
			to_date(ql.sbqq__effectiveenddate__c),
			dateadd(day, -1, dateadd(month, ql.subscriptionterm_formula__c, to_date(ql.sbqq__effectivestartdate__c))),
			sub_end_date
		) as term_end_date,
		case
			when has_oli_dates then 'OLI DATES'
			when ql.id is null then 'SUB DATES'
			when ql.sbqq__effectiveenddate__c is not null then 'QL DATES'
			else 'QL START + TERM'
		end as term_basis,
		round(months_between(dateadd(day, 1, term_end_date), term_start_date), 1) as term_months,
		case
			when is_zero_priced then 'ZERO PRICED'
			when oli.quote_line_id is null or ifnull(oli.oli_quantity, 0) = 0 then 'SUB PRICE'
			else 'OPP LINE'
		end as atr_basis,
		oli.oli_total * 12 / nullif(term_months, 0) as oli_annual_value,
		case when is_zero_priced then 0 else s.sbqq__customerprice__c end * 12 / nullif(term_months, 0) * atr_quantity as sub_price_annual_value,
		case when is_zero_priced then 0 else s.sbqq__customerprice__c * s.sbqq__quantity__c end * 12 / nullif(term_months, 0) as sub_price_acv
	from subscription s
	left join account a on a.id = s.sbqq__account__c
	left join product p on p.id = s.sbqq__product__c
	left join family_map f on f.family = p.product_family_custom__c
	left join quote_line ql on ql.id = s.sbqq__quoteline__c
	left join quote oq on oq.id = ql.sbqq__quote__c
	left join opportunity oo on oo.id = oq.sbqq__opportunity2__c
	left join contract c on c.id = s.sbqq__contract__c
	left join opp_lines oli on oli.quote_line_id = s.sbqq__quoteline__c
	left join replaced_qty rq on rq.subscription_id = s.id
),

sub_lines as (
	select
		s.*,
		case when s.quote_line_id is null then 1 else count(*) over (partition by s.quote_line_id) end as subs_on_opp_line,
		subs_on_opp_line > 1 as is_one_to_many,
		case
			when is_one_to_many then ifnull(s.customer_price * s.atr_quantity / nullif(sum(s.customer_price * s.atr_quantity) over (partition by s.quote_line_id), 0), 1 / subs_on_opp_line)
			else 1
		end as line_share,
		case
			when s.atr_basis = 'ZERO PRICED' then 0
			when s.atr_basis = 'SUB PRICE' then s.sub_price_annual_value
			when is_one_to_many then s.oli_annual_value * line_share
			else s.oli_annual_value * s.atr_quantity / s.oli_quantity
		end as annual_value,
		annual_value / nullif(s.atr_quantity, 0) as annual_unit_price,
		coalesce(s.oli_acv * line_share, s.sub_price_acv) as renewal_acv,
		min(s.sub_start_date) over (partition by coalesce(s.origin_quote_id, s.subscription_id), s.product_id) as group_first_start
	from subs s
)

select
	l.*,
	sum(l.renewal_acv) over (partition by coalesce(l.origin_quote_id, l.subscription_id), l.product_id) as group_acv,
	sum(case when l.sub_start_date = l.group_first_start then l.annual_value else 0 end)
		over (partition by coalesce(l.origin_quote_id, l.subscription_id), l.product_id) as group_first_entry,
	l.renewal_acv
		+ case
			when l.sub_start_date = l.group_first_start then greatest(group_first_entry - group_acv, 0) * ifnull(l.annual_value / nullif(group_first_entry, 0), 0)
			else 0
		end as renewal_value,
	l.origin_quote_id is not null and l.sub_end_date < max(l.sub_end_date) over (partition by l.origin_quote_id, l.product_id) as is_ramp_interim,
	case when is_ramp_interim then 0 else l.annual_value end as exit_atr,
	case
		when l.replacement_status = 'Partial Replacement' then least(1, ifnull(l.replaced_quantity, 0) / nullif(l.atr_quantity, 0))
		else 0
	end as replaced_ratio,
	l.item_type = 'Selling Item'
		and l.sub_end_date >= '2025-11-01'
		and (l.origin_opportunity_id is null or l.origin_opp_stage in ('Closed Won', 'Consumption - Closed')) as in_population
from sub_lines l
;


create or replace table analytics_sandbox.main.atr_renewals_t as

with

atr_sub_base as (
	select * from analytics_sandbox.main.atr_sub_base_t
),

opportunity_line as (
	select * from staging.salesforce.stg_salesforce__opportunity_line_item
),

opportunity as (
	select * from staging.salesforce.stg_salesforce__opportunity
),

quote_line as (
	select * from staging.salesforce.stg_salesforce__sbqq__quoteline
),

quote as (
	select * from staging.salesforce.stg_salesforce__sbqq__quote
),

product as (
	select * from staging.salesforce.stg_salesforce__product2
),

fx_rate as (
	select * from datalake_db.salesforce.datedconversionrate
),


family_map as (
	select distinct
		product_family_custom__c as family,
		family_group
	from atr_sub_base
	where family_group is not null
),

contracted as (
	select distinct origin_opportunity_id as opp_id
	from atr_sub_base
	where origin_opportunity_id is not null
),


deal_lines as (
	select
		oli.opp_id,
		o.name as opp_name,
		oli.opportunity_line_id as opp_line_id,
		oli.sbqq__quoteline__c as quote_line_id,
		ql.sbqq__renewedsubscription__c as renewed_subscription_id,
		oli.sbqq__quoteline__c is not null as is_cpq,
		coalesce(o.named_end_tenant__c, o.accountid) as tenant_id,
		o.currencyisocode as currency,
		to_date(o.closedate) as close_date,
		oli.product2id as product_id,
		p.productcode as product_code,
		p.product_family_custom__c,
		f.family_group,
		oli.quantity,
		oli.totalprice,
		oli.acv__c as acv,
		to_date(oli.line_start_date__c) as line_start_date,
		to_date(oli.line_end_date__c) as line_end_date,
		round(months_between(dateadd(day, 1, to_date(oli.line_end_date__c)), to_date(oli.line_start_date__c)), 1) as line_months,
		oli.totalprice * 12 / nullif(line_months, 0) as annual_value
	from opportunity_line oli
	join opportunity o on o.id = oli.opp_id and o.stagename = 'Closed Won'
	left join quote_line ql on ql.id = oli.sbqq__quoteline__c
	left join quote q on q.id = ql.sbqq__quote__c
	left join product p on p.id = oli.product2id
	left join family_map f on f.family = p.product_family_custom__c
	where not ifnull(oli.isdeleted, false)
		and (oli.sbqq__quoteline__c is null
			or (q.sbqq__opportunity2__c = oli.opp_id and not ifnull(ql.isdeleted, false) and not ifnull(q.isdeleted, false)))
		and ifnull(ql.item_type__c, 'Selling Item') = 'Selling Item'
		and ql.sbqq__upgradedsubscription__c is null
		and f.family_group is not null
),

deal_ramps as (
	select
		l.*,
		min(l.line_start_date) over (partition by l.opp_id, l.product_id) as product_first_start
	from deal_lines l
),


valued as (
	select
		r.*,
		sum(ifnull(r.acv, 0)) over (partition by r.opp_id, r.product_id) as product_acv,
		sum(case when r.line_start_date = r.product_first_start then ifnull(r.annual_value, 0) else 0 end)
			over (partition by r.opp_id, r.product_id) as product_first_annual,
		ifnull(r.acv, 0)
			+ case
				when r.line_start_date = r.product_first_start then greatest(product_first_annual - product_acv, 0) * ifnull(r.annual_value / nullif(product_first_annual, 0), 0)
				else 0
			end as renewal_value
	from deal_ramps r
),

deal_fx as (
	select
		d.opp_id,
		fx.isocode as currency,
		fx.conversionrate as rate
	from (select distinct opp_id, close_date from deal_lines) d
	join fx_rate fx on d.close_date >= fx.startdate and d.close_date < fx.nextstartdate
	qualify row_number() over (partition by d.opp_id, fx.isocode order by fx.startdate desc) = 1
)

select
	v.opp_id,
	v.opp_name,
	v.opp_line_id,
	v.quote_line_id,
	v.renewed_subscription_id,
	v.is_cpq,
	c.opp_id is not null as is_contracted,
	v.tenant_id,
	v.currency,
	v.close_date,
	v.product_id,
	v.product_code,
	v.product_family_custom__c,
	v.family_group,
	v.quantity,
	v.totalprice,
	v.acv,
	v.line_start_date,
	v.line_end_date,
	v.line_months,
	v.annual_value,
	v.renewal_value,
	v.renewal_value / fx.rate as renewal_value_usd,
	min(v.line_start_date) over (partition by v.opp_id) as deal_start_date,
	max(v.line_end_date) over (partition by v.opp_id) as deal_end_date
from valued v
join deal_fx fx on fx.opp_id = v.opp_id and fx.currency = v.currency
left join contracted c on c.opp_id = v.opp_id
;


