create or replace table analytics_sandbox.main.atr_matched_t as

with

-- imports
atr_sub_base as (
	select * from analytics_sandbox.main.atr_sub_base_t
),

atr_renewals as (
	select * from analytics_sandbox.main.atr_renewals_t
),

quote_line as (
	select * from staging.salesforce.stg_salesforce__sbqq__quoteline
),

quote as (
	select * from staging.salesforce.stg_salesforce__sbqq__quote
),

opportunity as (
	select * from staging.salesforce.stg_salesforce__opportunity
),

contract as (
	select * from staging.salesforce.stg_salesforce__contract
),

replacement as (
	select * from staging.salesforce.stg_salesforce__replacement
),

subscribed_asset as (
	select * from staging.salesforce.stg_salesforce__sbqq__subscribedasset
),

asset as (
	select * from staging.salesforce.stg_salesforce__asset
),

account_asset as (
	select * from staging.salesforce.stg_salesforce__accountassets
),

product as (
	select * from staging.salesforce.stg_salesforce__product2
),

account as (
	select * from staging.salesforce.stg_salesforce__account
),

fx_rate as (
	select * from datalake_db.salesforce.datedconversionrate
),



linkable_subs as (
	select *
	from atr_sub_base
	where item_type = 'Selling Item'
		and exit_atr > 0
),

family_map as (
	select distinct
		product_family_custom__c as family,
		family_group
	from atr_sub_base
	where family_group is not null
),

deals as (
	select
		opp_id,
		any_value(tenant_id) as tenant_id,
		any_value(close_date) as close_date,
		any_value(deal_start_date) as start_date,
		any_value(deal_end_date) as end_date
	from atr_renewals
	group by 1
),

deal_dollars as (
	select
		opp_id,
		family_group,
		sum(renewal_value_usd) as pool_usd
	from atr_renewals
	group by 1, 2
	having pool_usd > 0
),

deal_fx as (
	select
		d.opp_id,
		fx.isocode as currency,
		fx.conversionrate as rate
	from deals d
	join fx_rate fx on d.close_date >= fx.startdate and d.close_date < fx.nextstartdate
	qualify row_number() over (partition by d.opp_id, fx.isocode order by fx.startdate desc) = 1
),

renewal_opps as (
	select
		ql.sbqq__renewedsubscription__c as subscription_id,
		q.sbqq__opportunity2__c as renewal_opp_id
	from quote_line ql
	join quote q on q.id = ql.sbqq__quote__c and q.sbqq__primary__c and not ifnull(q.isdeleted, false)
	where not ifnull(ql.isdeleted, false)
		and ql.sbqq__renewedsubscription__c is not null
	union
	select
		s.subscription_id,
		c.sbqq__renewalopportunity__c as renewal_opp_id
	from linkable_subs s
	join contract c on c.id = s.contract_id
	where c.sbqq__renewalopportunity__c is not null
),

open_renewals as (
	select distinct r.subscription_id
	from renewal_opps r
	join opportunity o on o.id = r.renewal_opp_id
	where o.stagename not ilike 'closed%'
		and o.stagename <> 'Consumption - Closed'
),

consolidated_into as (
	select
		o1.id as start_opp_id,
		case when o2.stagename = 'Closed Won' then o2.id
			when o3.stagename = 'Closed Won' then o3.id
			when o4.stagename = 'Closed Won' then o4.id
			when o5.stagename = 'Closed Won' then o5.id
			when o6.stagename = 'Closed Won' then o6.id end as opp_id
	from opportunity o1
	join opportunity o2 on o2.id = o1.consolidated_into__c
	left join opportunity o3 on o3.id = o2.consolidated_into__c and o2.stagename <> 'Closed Won'
	left join opportunity o4 on o4.id = o3.consolidated_into__c and o3.stagename <> 'Closed Won'
	left join opportunity o5 on o5.id = o4.consolidated_into__c and o4.stagename <> 'Closed Won'
	left join opportunity o6 on o6.id = o5.consolidated_into__c and o5.stagename <> 'Closed Won'
	where o1.consolidated_into__c <> o1.id
		and o1.stagename <> 'Closed Won'
		and opp_id is not null
),


direct_links as (
	select
		s.subscription_id,
		r.opp_id,
		'DIRECT' as link_type,
		null as fill_tier,
		1 as priority,
		s.family_group,
		s.exit_atr * (1 - s.replaced_ratio) as cap_local,
		sum(r.renewal_value) as renewed_value
	from atr_renewals r
	join linkable_subs s on s.subscription_id = r.renewed_subscription_id
	group by 1, 2, 3, 4, 5, 6, 7
),

replacement_links as (
	select
		s.subscription_id,
		q.sbqq__opportunity2__c as opp_id,
		'REPLACEMENT' as link_type,
		null as fill_tier,
		2 as priority,
		s.family_group,
		s.exit_atr * case when s.replacement_status = 'Partial Replacement' then s.replaced_ratio else 1 end as cap_local
	from replacement r
	join quote q on q.id = r.replacement_quote_c and not ifnull(q.isdeleted, false)
	join opportunity o on o.id = q.sbqq__opportunity2__c and o.stagename = 'Closed Won'
	join linkable_subs s on s.subscription_id = r.original_subscription_c
	where not ifnull(r.isdeleted, false)
		and r.status_c = 'Replaced'
	qualify row_number() over (partition by s.subscription_id, q.sbqq__opportunity2__c order by r.lastmodifieddate desc) = 1
),


sub_assets as (
	select
		sa.sbqq__subscription__c as subscription_id,
		sa.sbqq__asset__c as asset_id,
		ifnull(sa.asset_price__c * sa.asset_quantity__c, 0) as asset_value,
		f.family_group as asset_family_group
	from subscribed_asset sa
	left join asset a on a.id = sa.sbqq__asset__c
	left join product p on p.id = a.product2id
	left join family_map f on f.family = p.product_family_custom__c
	where not ifnull(sa.isdeleted, false)
),

sub_asset_totals as (
	select
		subscription_id,
		sum(asset_value) as total_asset_value,
		count(*) as total_assets
	from sub_assets
	group by 1
),

converted_assets as (
	select
		aa.asset__c as asset_id,
		q.sbqq__opportunity2__c as opp_id,
		least(1, ifnull(aa.converted_qty__c / nullif(aa.orginal_quantity__c, 0), 1)) as converted_ratio
	from account_asset aa
	join quote q on q.id = aa.quote__c and not ifnull(q.isdeleted, false)
	join opportunity o on o.id = q.sbqq__opportunity2__c and o.stagename = 'Closed Won'
	where not ifnull(aa.isdeleted, false)
		and aa.status__c in ('Converted', 'Pending Conversion activation')
	qualify row_number() over (partition by aa.asset__c order by (aa.status__c = 'Converted') desc, aa.lastmodifieddate desc) = 1
),

conversion_links as (
	select
		s.subscription_id,
		ca.opp_id,
		'CONVERSION' as link_type,
		null as fill_tier,
		3 as priority,
		sa.asset_family_group as family_group,
		any_value(s.exit_atr) * least(1,
			case
				when any_value(t.total_asset_value) > 0 then sum(sa.asset_value * ca.converted_ratio) / any_value(t.total_asset_value)
				else sum(ca.converted_ratio) / any_value(t.total_assets)
			end
		) as cap_local
	from sub_assets sa
	join converted_assets ca on ca.asset_id = sa.asset_id
	join sub_asset_totals t on t.subscription_id = sa.subscription_id
	join linkable_subs s on s.subscription_id = sa.subscription_id
	where sa.asset_family_group is not null
	group by s.subscription_id, ca.opp_id, sa.asset_family_group
),

contract_renewals as (
	select
		c.id as contract_id,
		c.sbqq__renewalopportunity__c as opp_id
	from contract c
	join opportunity o on o.id = c.sbqq__renewalopportunity__c and o.stagename = 'Closed Won'
	union
	select
		sbqq__renewedcontract__c as contract_id,
		id as opp_id
	from opportunity
	where sbqq__renewedcontract__c is not null
		and stagename = 'Closed Won'
),

contract_links as (
	select
		s.subscription_id,
		cr.opp_id,
		'CONTRACT' as link_type,
		null as fill_tier,
		4 as priority,
		s.family_group,
		s.exit_atr as cap_local
	from linkable_subs s
	join contract_renewals cr on cr.contract_id = s.contract_id
),

consolidated_links as (
	select distinct
		s.subscription_id,
		ci.opp_id,
		'LINKED EXPANSION' as link_type,
		'VIA CONSOLIDATED INTO' as fill_tier,
		5 as priority,
		s.family_group,
		s.exit_atr as cap_local
	from renewal_opps r
	join consolidated_into ci on ci.start_opp_id = r.renewal_opp_id
	join linkable_subs s on s.subscription_id = r.subscription_id
),

related_links as (
	select distinct
		s.subscription_id,
		case when ro.stagename = 'Closed Won' then ro.id else ci.opp_id end as opp_id,
		'LINKED EXPANSION' as link_type,
		'VIA RELATED PRODUCT OPP' as fill_tier,
		5 as priority,
		s.family_group,
		s.exit_atr as cap_local
	from renewal_opps r
	join opportunity o on o.id = r.renewal_opp_id
	join opportunity ro on ro.id = coalesce(o.related_product_opportunity__c, o.related_product_opportunity_id)
	left join consolidated_into ci on ci.start_opp_id = ro.id
	join linkable_subs s on s.subscription_id = r.subscription_id
	where ((o.stagename ilike 'closed%' and o.stagename <> 'Closed Won') or o.stagename = 'Consumption - Closed')
		and (ro.stagename = 'Closed Won' or ci.opp_id is not null)
),

linked_deals as (
	select subscription_id, opp_id from direct_links
	union select subscription_id, opp_id from replacement_links
	union select subscription_id, opp_id from conversion_links
	union select subscription_id, opp_id from contract_links
	union select subscription_id, opp_id from consolidated_links
	union select subscription_id, opp_id from related_links
),

sub_tenants as (
	select
		subscription_id,
		tenant_id
	from linkable_subs
	union
	select
		l.subscription_id,
		coalesce(o.named_end_tenant__c, o.accountid) as tenant_id
	from linked_deals l
	join opportunity o on o.id = l.opp_id
),


account_links as (
	select
		s.subscription_id,
		d.opp_id,
		'ACCOUNT EXPANSION' as link_type,
		case
			when datediff(day, dateadd(day, 1, s.effective_end_date), d.start_date) between -90 and 90 then 'ON TIME'
			when datediff(day, dateadd(day, 1, s.effective_end_date), d.start_date) > 90 then 'LATE'
			else 'EARLY'
		end as fill_tier,
		case when fill_tier = 'EARLY' then 7 else 6 end as priority,
		s.family_group,
		s.exit_atr as cap_local
	from linkable_subs s
	join sub_tenants t on t.subscription_id = s.subscription_id
	join deals d on d.tenant_id = t.tenant_id
	left join linked_deals ld on ld.subscription_id = s.subscription_id and ld.opp_id = d.opp_id
	where ld.opp_id is null
		and d.close_date > ifnull(s.origin_close_date, s.sub_start_date)
		and d.end_date > dateadd(day, 31, s.effective_end_date)
		and d.start_date <= dateadd(day, 180, s.effective_end_date)
	qualify row_number() over (partition by s.subscription_id, d.opp_id order by d.opp_id) = 1
),

all_links as (
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from direct_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from replacement_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from conversion_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from contract_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from consolidated_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from related_links
	union all
	select subscription_id, opp_id, link_type, fill_tier, priority, family_group, cap_local from account_links
),


best_link as (
	select
		l.*,
		s.sub_end_date,
		fx.rate,
		r.pool_usd,
		least(s.exit_atr, l.cap_local) / fx.rate as need_usd
	from all_links l
	join linkable_subs s on s.subscription_id = l.subscription_id
	join deal_dollars r on r.opp_id = l.opp_id and r.family_group = l.family_group
	join deal_fx fx on fx.opp_id = l.opp_id and fx.currency = s.currency
	left join open_renewals o on o.subscription_id = l.subscription_id
	where l.cap_local > 0
		and (l.priority < 5 or o.subscription_id is null)
	qualify row_number() over (partition by l.subscription_id order by l.priority, r.pool_usd desc, l.opp_id) = 1
),


fill_queue as (
	select
		b.*,
		ifnull(sum(b.need_usd) over (partition by b.opp_id, b.family_group order by b.priority, b.sub_end_date, b.subscription_id rows between unbounded preceding and 1 preceding), 0) as need_ahead_usd
	from best_link b
),

fills as (
	select
		q.*,
		least(q.need_usd, greatest(q.pool_usd - q.need_ahead_usd, 0)) as fill_usd,
		fill_usd * q.rate as fill_local
	from fill_queue q
),

direct_renewed as (
	select
		subscription_id,
		sum(renewed_value) as renewed_value
	from direct_links
	group by 1
)

select
	s.account_id,
	s.account_name,
	s.tenant_id as end_tenant_id,
	et.name as end_tenant_name,
	s.subscription_id,
	s.contract_id,
	s.currency,
	s.sub_start_date,
	s.sub_end_date,
	s.replacement_status,
	s.terminated_date,
	s.product_code,
	s.product_name,
	s.product_family_custom__c,
	s.family_group,

	s.origin_opportunity_id,
	s.origin_opportunity_name,
	s.opp_line_id,
	s.atr_basis,
	s.quantity,
	s.original_quantity,
	s.atr_quantity,
	s.oli_quantity,
	s.oli_total,
	s.term_start_date,
	s.term_end_date,
	s.term_months,
	s.term_basis,
	s.annual_unit_price,
	s.annual_value,
	s.is_ramp_interim,
	s.is_zero_priced,
	s.is_one_to_many,
	s.subs_on_opp_line,
	s.line_share,
	s.exit_atr,

	case when f.link_type = 'DIRECT' then f.fill_local else 0 end as filled_direct,
	case when f.link_type = 'REPLACEMENT' then f.fill_local else 0 end as filled_replacement,
	case when f.link_type = 'CONVERSION' then f.fill_local else 0 end as filled_conversion,
	case when f.link_type = 'CONTRACT' then f.fill_local else 0 end as filled_contract,
	case when f.link_type = 'LINKED EXPANSION' then f.fill_local else 0 end as filled_linked_expansion,
	case when f.link_type = 'ACCOUNT EXPANSION' then f.fill_local else 0 end as filled_account_expansion,
	ifnull(f.fill_local, 0) as filled_total,
	greatest(ifnull(s.exit_atr, 0) - filled_total, 0) as unfilled,
	filled_total / nullif(s.exit_atr, 0) as pct_filled,
	case
		when ifnull(s.exit_atr, 0) <= 0 then 'NO ATR'
		when filled_total <= 0.5 then 'UNFILLED'
		when filled_total < s.exit_atr - 0.5 then 'PARTIAL'
		else 'FILLED'
	end as fill_status,
	greatest(ifnull(dr.renewed_value, 0) - ifnull(s.exit_atr, 0), 0) as direct_renewal_above_atr,

	case when filled_total > 0.005 then 1 else 0 end as connection_count,
	case when filled_total > 0.005 then f.opp_id end as connection_1,
	case when filled_total > 0.005 then o.name end as connection_1_opp_name,
	case when filled_total > 0.005 then concat(f.link_type, ifnull(concat(' ', f.fill_tier), '')) end as connection_1_reason,
	case when filled_total > 0.005 then f.fill_local end as connection_1_filled,
	null as connection_2,
	null as connection_2_opp_name,
	null as connection_2_reason,
	null as connection_2_filled
from atr_sub_base s
left join fills f on f.subscription_id = s.subscription_id
left join opportunity o on o.id = f.opp_id
left join account et on et.id = s.tenant_id
left join direct_renewed dr on dr.subscription_id = s.subscription_id
where s.in_population
;
